{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "TeamOS",
	"version": "0.1.0",
	"identifier": "app.teamos.desktop",
	"build": {
		"frontendDist": "../ui"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["teamos"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis", "msi", "app", "dmg"],
		"category": "Productivity",
		"shortDescription": "TeamOS desktop app",
		"longDescription": "TeamOS in a desktop window: signs in through your browser, keeps running in the tray and tells you about new notifications.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"minimumSystemVersion": "11.0"
		}
	}
}
